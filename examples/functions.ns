fn greet(name) {
    println("Hello, {$name}!");
}

fn add(a, b) {
    return a + b;
}

fn factorial(n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

fn announce() {
    println("functions-ready");
}

nix main() {
    greet("NixScript");
    println(add(20, 22));
    println(factorial(5));
    announce();
}
