fn add(left, right);
fn add(first, second); // Compatible repeated declarations are allowed.
fn factorial(value);
fn announce();
fn neverCalled(value); // Unused prototypes are allowed.
fn maIn(value); // Case-sensitive: only lowercase main is reserved.
fn later(value);

fn earlier(value) {
    return later(value) + 1;
}

nix main() {
    println(add(20, 22));
    println(factorial(5));
    println(earlier(20));
    announce();
}

fn add(a, b) {
    return a + b;
}

fn factorial(n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

fn announce() {
    println("prototypes-ready");
}

fn later(value) {
    return value * 2;
}
