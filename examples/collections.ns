// CASE: Demonstrate the approved dynamic-array API alongside callbacks.
fn triple(int value) {
    return value * 3;
}

fn apply(function callback, int value) {
    return callback(value);
}

nix main() {
    var scores = {};
    scores.push(10);
    scores.push(20);
    scores.push(30);
    scores.set(1, 25);
    scores.push(40);
    scores.insert(scores.len(), 50);

    println(scores.len());
    println(scores.get(1));
    println(scores.contains(30));
    println(scores.indexOf(30));
    println(scores.pop());
    println(apply(triple, scores.get(0)));
}
