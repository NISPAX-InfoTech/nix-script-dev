async fn plusOne(value);

async fn plusOne(value) {
    return value + 1;
}

async fn isPositive(value) {
    return value > 0;
}

async fn nested(value) {
    var first = await plusOne(value);
    var second = await plusOne(first);
    return second;
}

async fn choose(value) {
    if (await isPositive(value)) {
        return value;
    } else {
        return 0;
    }
}

async fn work(value) {
    print("s", value);
    print("e", value);
    return value;
}

nix main() {
    var left = work(1);
    var right = work(2);
    var task = nested(40);
    var result = await task;
    var chosen = await choose(result);
    await left;
    await right;
    println("answer=", chosen);
}
