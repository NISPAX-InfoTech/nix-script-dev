{
  "name": "nixscript-language",
  "displayName": "NixScript Language Support",
  "description": "Syntax highlighting and language conveniences for NixScript .ns files.",
  "version": "1.0.0-beta.1",
  "publisher": "nispax",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "keywords": ["nixscript", "language", "ns"],
  "contributes": {
    "languages": [{
      "id": "nixscript",
      "aliases": ["NixScript", "nixscript"],
      "extensions": [".ns"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "nixscript",
      "scopeName": "source.nixscript",
      "path": "./syntaxes/nixscript.tmLanguage.json"
    }]
  }
}
